kubectl exec -it <toolbox-pod> -- python -c "import httpx2; print(httpx2.get('<external-mcp-base-url>', timeout=10, trust_env=False))"

kubectl exec -it <toolbox-pod> -- python -c "
import asyncio, os, httpx2
from mcp import ClientSession
from mcp.client.streamable_http import streamable_http_client

URL = os.environ['BNPP_TOOLBOX_URL']
HEADERS = {'bitbucket-token': os.environ['BITBUCKET_TOKEN']}

async def main():
    async with httpx2.AsyncClient(headers=HEADERS, timeout=30, trust_env=False) as client:
        async with streamable_http_client(URL, http_client=client) as (read, write):
            async with ClientSession(read, write) as session:
                await session.initialize()
                print(len((await session.list_tools()).tools), 'tools')

asyncio.run(main())
"
