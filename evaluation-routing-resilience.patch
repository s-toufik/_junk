diff --git a/tests/evaluation/test_resilience.py b/tests/evaluation/test_resilience.py
new file mode 100644
index 0000000..980aa45
--- /dev/null
+++ b/tests/evaluation/test_resilience.py
@@ -0,0 +1,379 @@
+"""Offline tests of the retry layer and the routing metrics: no model, no toolbox."""
+
+import asyncio
+import json
+from collections.abc import Iterator
+from datetime import datetime
+
+import httpx
+import pytest
+from langchain_core.exceptions import ModelInvalidRequestError, ModelRateLimitError
+from pycraftcore.circuit_breaker.exception.circuit_breaker_open_exception import (
+    CircuitBreakerOpenException,
+)
+
+from agent_orchestrator.domain.conversation.conversation import Conversation
+from agent_orchestrator.domain.exception.agent_unavailable_exception import (
+    AgentUnavailableException,
+)
+from agent_orchestrator.domain.turn.answer import Answer
+from agent_orchestrator.domain.turn.intent import Intent
+from agent_orchestrator.domain.turn.outcome import Outcome
+from agent_orchestrator.domain.turn.turn import Turn
+from agent_orchestrator.domain.workflow.step import Step
+from tests.agent_orchestrator.domain.builders import answer, calling, failure, turn
+from tests.evaluation.harness.cases import PROPOSED, Case, Say
+from tests.evaluation.harness.exchange import Exchange
+from tests.evaluation.harness.expectation import Expect
+from tests.evaluation.harness.report import EvaluationReport
+from tests.evaluation.harness.resilience import (
+    ProviderHealth,
+    ProviderUnavailable,
+    Retrier,
+    RetryPolicy,
+    ToolboxUnreachable,
+    is_judge_failure,
+    is_provider_failure,
+    unreachable_tools,
+)
+from tests.evaluation.harness.route_coverage import RouteCoverage
+from tests.evaluation.harness.routing import RoutingStats, divergence
+from tests.evaluation.harness.runner import CaseEvaluator
+from tests.evaluation.harness.score import Check, Score
+from tests.evaluation.harness.settings import EvalSettings
+
+DIRECT = (Step.UNDERSTAND, Step.ACT, Step.FINISH, Step.SUMMARIZE)
+DIRECT_CASE = Case(
+    "a direct question",
+    (Say("capital of France?", Expect(intents=(Intent.DIRECT,), route=DIRECT, tools=())),),
+)
+
+
+def _answered(intent: Intent = Intent.DIRECT, text: str = "Paris") -> Turn:
+    current = turn(intent)
+    current.drafted(answer(text))
+    current.finish(Answer.answered(text))
+    return current
+
+
+def _exchange(route: tuple[Step, ...] = DIRECT, intent: Intent = Intent.DIRECT) -> Exchange:
+    return Exchange("capital of France?", route, _answered(intent), Conversation("c1"))
+
+
+def _http_status(code: int) -> httpx.HTTPStatusError:
+    request = httpx.Request("POST", "http://llm/v1/chat/completions")
+    return httpx.HTTPStatusError("x", request=request, response=httpx.Response(code))
+
+
+class _Clock:
+    def __init__(self) -> None:
+        self.waits: list[float] = []
+
+    async def sleep(self, seconds: float) -> None:
+        self.waits.append(seconds)
+
+
+def _retrier(attempts: int = 3, timeout: float = 5.0, **kwargs) -> tuple[Retrier, _Clock, list]:
+    clock, incidents = _Clock(), []
+    policy = RetryPolicy(attempts=attempts, first_delay=1.0, max_delay=4.0, timeout=timeout)
+    retrier = Retrier(
+        policy, lambda *incident: incidents.append(incident), sleep=clock.sleep, **kwargs
+    )
+    return retrier, clock, incidents
+
+
+class _Scripted:
+    """Stands in for EvalSession: each say() takes the next exchange, or raises it."""
+
+    def __init__(self, script: Iterator[Exchange | Exception]) -> None:
+        self._script = script
+
+    async def say(self, message: str, auto_approve: bool = False) -> Exchange:
+        step = next(self._script)
+        if isinstance(step, Exception):
+            raise step
+        return step
+
+
+def _evaluator(script: list, repeats: int = 3, abort_after: int = 2):
+    steps = iter(script)
+    retrier, _, incidents = _retrier()
+    coverage, routing, health = RouteCoverage(), RoutingStats(), ProviderHealth(abort_after)
+    evaluator = CaseEvaluator(
+        lambda: _Scripted(steps), retrier, health, repeats, 0.8, coverage, routing
+    )
+    return evaluator, routing, health, incidents
+
+
+# --- telling the provider's failures from the agent's --------------------------------
+
+
+@pytest.mark.parametrize(
+    "error",
+    [
+        AgentUnavailableException("429"),
+        ModelRateLimitError("slow down"),
+        CircuitBreakerOpenException("llm-gateway open"),
+        httpx.ConnectError("refused"),
+        httpx.ReadTimeout("slow"),
+        TimeoutError(),
+        ToolboxUnreachable("python_executor: ConnectError"),
+        _http_status(503),
+        _http_status(429),
+    ],
+    ids=lambda error: type(error).__name__,
+)
+def test_outages_are_the_providers_fault(error: Exception) -> None:
+    assert is_provider_failure(error)
+
+
+@pytest.mark.parametrize(
+    "error",
+    [
+        ValueError("the agent got it wrong"),
+        AssertionError("score below the threshold"),
+        ModelInvalidRequestError("context too long"),
+        _http_status(400),
+        _http_status(401),
+    ],
+    ids=lambda error: type(error).__name__,
+)
+def test_mistakes_and_rejected_requests_are_not_retried(error: Exception) -> None:
+    assert not is_provider_failure(error)
+
+
+def test_an_outage_is_found_however_deep_it_was_wrapped() -> None:
+    try:
+        try:
+            raise httpx.ConnectError("refused")
+        except httpx.ConnectError as cause:
+            raise RuntimeError("graph node failed") from cause
+    except RuntimeError as wrapped:
+        assert is_provider_failure(wrapped)
+
+    assert is_provider_failure(ExceptionGroup("tasks", [ValueError(), TimeoutError()]))
+
+
+def test_a_judge_that_answers_unreadable_json_is_a_judge_failure_only() -> None:
+    unreadable = ValueError("Evaluation LLM outputted an invalid JSON. Please use a better model.")
+
+    assert is_judge_failure(unreadable) and not is_provider_failure(unreadable)
+    assert is_judge_failure(AgentUnavailableException("503"))
+    assert not is_judge_failure(ZeroDivisionError())
+
+
+def test_a_tool_call_lost_to_the_network_is_told_from_a_tool_that_failed() -> None:
+    current = turn(Intent.TASK)
+    current.drafted(calling("python_executor", "file_reader"))
+    current.observed(
+        [
+            failure("python_executor", "MCP call failed: httpx.ConnectError: refused", "c0"),
+            failure("file_reader", "FileNotFoundError: eval_probe.txt", "c1"),
+        ]
+    )
+
+    assert unreachable_tools(current) == [
+        "python_executor: MCP call failed: httpx.ConnectError: refused"
+    ]
+
+
+# --- retrying ------------------------------------------------------------------------
+
+
+async def test_a_run_is_retried_until_the_provider_answers() -> None:
+    retrier, clock, incidents = _retrier()
+    outcomes = iter([AgentUnavailableException("503"), httpx.ConnectError("refused"), "done"])
+
+    async def attempt() -> str:
+        outcome = next(outcomes)
+        if isinstance(outcome, Exception):
+            raise outcome
+        return outcome
+
+    assert await retrier.run("case", attempt) == "done"
+    assert [(label, number) for label, number, _ in incidents] == [("case", 1), ("case", 2)]
+    assert len(clock.waits) == 2 and 0.75 <= clock.waits[0] <= 1.25 <= clock.waits[1] <= 2.5
+
+
+async def test_an_agent_error_is_not_retried() -> None:
+    retrier, clock, incidents = _retrier()
+
+    async def attempt() -> None:
+        raise KeyError("a bug in the agent")
+
+    with pytest.raises(KeyError):
+        await retrier.run("case", attempt)
+    assert clock.waits == [] and incidents == []
+
+
+async def test_after_the_last_attempt_the_run_is_given_up_as_unscored() -> None:
+    retrier, clock, incidents = _retrier(attempts=2)
+
+    async def attempt() -> None:
+        raise AgentUnavailableException("502 Bad Gateway")
+
+    with pytest.raises(ProviderUnavailable, match="gave up after 2 attempt"):
+        await retrier.run("case", attempt)
+    assert len(incidents) == 2 and len(clock.waits) == 1
+
+
+async def test_an_attempt_that_hangs_is_abandoned_and_retried() -> None:
+    retrier, _, incidents = _retrier(attempts=2, timeout=0.01)
+
+    async def attempt() -> None:
+        await asyncio.sleep(1)
+
+    with pytest.raises(ProviderUnavailable):
+        await retrier.run("case", attempt)
+    assert [type(error) for _, _, error in incidents] == [TimeoutError, TimeoutError]
+
+
+def test_an_open_circuit_breaker_is_given_time_to_close() -> None:
+    policy = RetryPolicy(first_delay=1.0, breaker_wait=30.0)
+
+    assert policy.wait(1, CircuitBreakerOpenException("open")) >= 30.0
+    assert policy.wait(1, httpx.ConnectError("refused")) < 2.0
+
+
+def test_the_provider_is_declared_down_after_runs_in_a_row_give_up() -> None:
+    health = ProviderHealth(abort_after=2)
+    gave_up = ProviderUnavailable("case", 3, TimeoutError())
+
+    health.exhausted(gave_up)
+    health.succeeded()
+    health.exhausted(gave_up)
+    health.ensure_up()
+
+    health.exhausted(gave_up)
+    with pytest.raises(ProviderUnavailable, match="provider down since: case: gave up"):
+        health.ensure_up()
+
+
+# --- repeated runs ---------------------------------------------------------------------
+
+
+async def test_a_case_is_scored_over_every_run_that_completed() -> None:
+    wrong = _exchange(route=PROPOSED)
+    evaluator, routing, _, incidents = _evaluator(
+        [_exchange(), AgentUnavailableException("503"), wrong, _exchange()]
+    )
+
+    score = await evaluator.evaluate(DIRECT_CASE)
+
+    assert (score.runs, score.clean_runs, score.unscored_runs) == (3, 2, 0)
+    assert score.flaky and len(incidents) == 1
+    assert score.failures[0].endswith("(1/3 runs)")
+    assert routing.route.render() == "2/3 (67%)"
+    assert routing.divergences == {"step 2: act -> plan": 1}
+
+
+async def test_a_run_lost_to_the_provider_is_left_out_not_failed() -> None:
+    down = [AgentUnavailableException("503")] * 3
+    evaluator, routing, _, _ = _evaluator([_exchange(), *down, _exchange()], abort_after=5)
+
+    score = await evaluator.evaluate(DIRECT_CASE)
+
+    assert (score.value, score.runs, score.unscored_runs) == (1.0, 2, 1)
+    assert routing.turns == 2
+
+
+async def test_a_case_with_no_completed_run_is_not_scored() -> None:
+    evaluator, _, health, _ = _evaluator([AgentUnavailableException("503")] * 9, abort_after=2)
+
+    with pytest.raises(ProviderUnavailable):
+        await evaluator.evaluate(DIRECT_CASE)
+    assert health.down is not None
+
+
+async def test_once_the_provider_is_down_the_runs_left_are_not_attempted() -> None:
+    down = [AgentUnavailableException("503")] * 6
+    evaluator, _, health, _ = _evaluator([_exchange(), *down], repeats=5, abort_after=2)
+
+    score = await evaluator.evaluate(DIRECT_CASE)
+
+    assert (score.runs, score.unscored_runs) == (1, 4) and health.down is not None
+
+
+def test_failures_across_runs_are_counted_once_each() -> None:
+    right, wrong = [Check("route", True)], [Check("route", False, "route went to plan")]
+
+    score = Score.of_runs("case", [right, wrong, wrong], threshold=0.8)
+
+    assert (round(score.value, 2), score.reliability, score.flaky) == (0.33, "1/3", True)
+    assert score.failures == ("route went to plan (2/3 runs)",)
+    assert "1/3 runs fully correct" in score.explain()
+    assert Score.of_runs("case", [wrong], 0.8) == Score.of_checks("case", wrong, 0.8)
+
+
+# --- routing metrics -------------------------------------------------------------------
+
+
+def test_divergence_names_the_first_step_that_differs() -> None:
+    assert divergence(DIRECT, DIRECT) is None
+    assert divergence(DIRECT, PROPOSED) == "step 2: act -> plan"
+    assert divergence(DIRECT, DIRECT[:2]) == "step 3: finish -> (stopped)"
+    assert divergence(DIRECT[:2], DIRECT) == "step 3: (end) -> finish"
+
+
+def test_routing_stats_pool_intents_routes_and_broken_rules() -> None:
+    stats = RoutingStats()
+    expect = Expect(intents=(Intent.DIRECT,), outcome=Outcome.ANSWERED, route=DIRECT, tools=())
+
+    stats.record(expect, _exchange(), [Check("route shape", True)])
+    stats.record(
+        expect,
+        _exchange(route=PROPOSED, intent=Intent.TASK),
+        [Check("plan reviewed", False, "not reviewed")],
+    )
+
+    assert stats.intent.render() == "1/2 (50%)" and stats.outcome.render() == "2/2 (100%)"
+    assert "  intent confused: direct -> task x1" in stats.report()
+    assert "  route left the path at: step 2: act -> plan x1" in stats.report()
+    assert "  workflow rule broken: plan reviewed x1" in stats.report()
+    assert stats.as_dict()["intent_accuracy"] == {"right": 1, "total": 2, "rate": 0.5}
+
+
+# --- the report ------------------------------------------------------------------------
+
+
+def test_too_much_left_unscored_makes_the_evaluation_inconclusive(tmp_path) -> None:
+    report = EvaluationReport("m", 0.8, RouteCoverage(), RoutingStats(), max_unscored=0.2)
+    report.add(Score.of_runs("steady", [[Check("a", True)]] * 3, 0.8))
+    report.add(Score.of_runs("wobbly", [[Check("a", True)], [Check("a", False, "x")]], 0.8))
+    report.add_unscored("lost", "provider unavailable: gave up after 3 attempt(s)")
+    report.add_incident("lost [run 1/3]", 1, AgentUnavailableException("503"))
+
+    assert report.inconclusive
+    assert report.summary()[-1].startswith("INCONCLUSIVE: 1 of 3 tests could not be scored")
+    assert "1 flaky: right in some runs only" in report.summary()
+    assert "1 provider failures retried: AgentUnavailableException x1" in report.summary()
+
+    markdown, data = report.write(tmp_path, datetime(2026, 10, 14, 23, 0))
+    text = markdown.read_text()
+    assert "> **INCONCLUSIVE" in text
+    assert "| 0.50 | FAIL | route | wobbly | 1/2 · flaky |" in text
+    assert "## Provider failures retried" in text and "## Routing" in text
+    saved = json.loads(data.read_text())
+    assert saved["inconclusive"] and saved["provider_incidents"][0]["attempt"] == 1
+
+
+def test_a_provider_declared_down_makes_any_gap_inconclusive() -> None:
+    report = EvaluationReport("m", 0.8, RouteCoverage(), max_unscored=0.9)
+    report.add(Score.of_checks("ok", [], 0.8))
+    report.add_unscored("lost", "provider unavailable")
+    assert not report.inconclusive
+
+    report.provider_down = "model preflight: gave up after 3 attempt(s)"
+    assert report.inconclusive
+
+
+def test_eval_settings_come_from_the_environment(monkeypatch) -> None:
+    monkeypatch.setenv("EVAL_REPEATS", "5")
+    monkeypatch.setenv("EVAL_RETRY_DELAY", "0.5")
+    assert (EvalSettings.from_env().repeats, EvalSettings.from_env().retry_delay) == (5, 0.5)
+
+    for name, wrong in (("EVAL_REPEATS", "0"), ("EVAL_MAX_UNSCORED", "2"), ("EVAL_ATTEMPTS", "x")):
+        monkeypatch.setenv(name, wrong)
+        with pytest.raises(ValueError, match=name):
+            EvalSettings.from_env()
+        monkeypatch.delenv(name)
