+"""Telling a provider outage apart from a wrong answer.
+
+An evaluation measures the agent. When the LLM gateway or the MCP toolbox fails, the agent
+has done nothing wrong, so the run is retried from a fresh conversation, and if it still
+cannot complete it is left out of the scores instead of being counted as a failure.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import random
+from collections.abc import Awaitable, Callable, Iterator
+from dataclasses import dataclass
+
+import httpx
+from langchain_core.exceptions import ModelError
+from openai import APIConnectionError, APIStatusError, InternalServerError, RateLimitError
+from pycraftcore.circuit_breaker.exception.circuit_breaker_open_exception import (
+    CircuitBreakerOpenException,
+)
+from pydantic import ValidationError
+
+from agent_orchestrator.domain.exception.agent_unavailable_exception import (
+    AgentUnavailableException,
+)
+from agent_orchestrator.domain.exception.tool_unavailable_exception import (
+    ToolUnavailableException,
+)
+from agent_orchestrator.domain.turn.turn import Turn
+from tests.evaluation.harness.settings import EvalSettings
+
+
+class ToolboxUnreachable(Exception):
+    """A tool call failed because the MCP server could not be reached, not because of the call."""
+
+
+class ProviderUnavailable(Exception):
+    """Every attempt failed on the provider side; the run could not be scored."""
+
+    def __init__(self, label: str, attempts: int, cause: BaseException | None) -> None:
+        self.label = label
+        self.attempts = attempts
+        self.cause = cause
+        super().__init__(f"{label}: gave up after {attempts} attempt(s): {describe(cause)}")
+
+
+RETRYABLE_STATUS: frozenset[int] = frozenset({408, 409, 425, 429})
+
+_TRANSIENT: tuple[type[BaseException], ...] = (
+    AgentUnavailableException,
+    ToolUnavailableException,
+    ToolboxUnreachable,
+    CircuitBreakerOpenException,
+    APIConnectionError,  # includes APITimeoutError
+    RateLimitError,
+    InternalServerError,
+    httpx.TransportError,  # connect / read / write / pool timeouts, protocol errors
+    TimeoutError,
+    ConnectionError,
+)
+
+# How a transport failure reads once the MCP adapter has folded it into a ToolResult.
+_UNREACHABLE_MARKERS: tuple[str, ...] = (
+    "ConnectError",
+    "ConnectTimeout",
+    "ReadTimeout",
+    "WriteTimeout",
+    "PoolTimeout",
+    "RemoteProtocolError",
+    "Connection refused",
+    "CircuitBreakerOpenException",
+    "ToolUnavailableException",
+)
+
+
+def describe(error: BaseException | None) -> str:
+    if error is None:
+        return "no error recorded"
+    return f"{type(error).__name__}: {error}"[:300]
+
+
+def _chain(error: BaseException) -> Iterator[BaseException]:
+    seen: set[int] = set()
+    pending: list[BaseException] = [error]
+    while pending:
+        current = pending.pop()
+        if id(current) in seen:
+            continue
+        seen.add(id(current))
+        yield current
+        if isinstance(current, BaseExceptionGroup):
+            pending.extend(current.exceptions)
+        pending.extend(e for e in (current.__cause__, current.__context__) if e is not None)
+
+
+def _status(error: BaseException) -> int | None:
+    if isinstance(error, APIStatusError):
+        return error.status_code
+    if isinstance(error, httpx.HTTPStatusError):
+        return error.response.status_code
+    return None
+
+
+def _transient(error: BaseException) -> bool:
+    if isinstance(error, ModelError):
+        # LangChain already knows: rate limit, 5xx, connection and timeout retry; 4xx do not.
+        return error.is_retryable
+    if isinstance(error, _TRANSIENT):
+        return True
+    status = _status(error)
+    return status is not None and (status in RETRYABLE_STATUS or status >= 500)
+
+
+def is_provider_failure(error: BaseException) -> bool:
+    """True when the error, or anything it was raised from, is the provider's fault."""
+    return any(_transient(link) for link in _chain(error))
+
+
+def is_judge_failure(error: BaseException) -> bool:
+    """A judge call that failed or answered in a shape DeepEval could not read."""
+    if is_provider_failure(error):
+        return True
+    return any(
+        isinstance(link, ValidationError | json.JSONDecodeError)
+        or (isinstance(link, ValueError) and "invalid JSON" in str(link))
+        for link in _chain(error)
+    )
+
+
+def unreachable_tools(turn: Turn) -> list[str]:
+    """Tool results that failed because the toolbox was down, not because of the call itself."""
+    return [
+        f"{result.tool_name}: {result.error[:200]}"
+        for result in turn.evidence
+        if result.error and any(marker in result.error for marker in _UNREACHABLE_MARKERS)
+    ]
+
+
+def raise_if_toolbox_unreachable(turn: Turn) -> None:
+    failed = unreachable_tools(turn)
+    if failed:
+        raise ToolboxUnreachable("; ".join(failed))
+
+
+Sleep = Callable[[float], Awaitable[None]]
+OnIncident = Callable[[str, int, BaseException], None]
+
+
+@dataclass(frozen=True, slots=True)
+class RetryPolicy:
+    attempts: int = 3
+    first_delay: float = 5.0
+    max_delay: float = 60.0
+    breaker_wait: float = 30.0
+    timeout: float = 600.0
+
+    @classmethod
+    def of(cls, settings: EvalSettings) -> RetryPolicy:
+        return cls(
+            attempts=settings.attempts,
+            first_delay=settings.retry_delay,
+            max_delay=settings.max_delay,
+            breaker_wait=settings.breaker_wait,
+            timeout=settings.timeout,
+        )
+
+    def wait(self, failed_attempt: int, error: BaseException) -> float:
+        backoff = min(self.max_delay, self.first_delay * 2 ** (failed_attempt - 1))
+        jittered = backoff * random.uniform(0.75, 1.25)
+        if any(isinstance(link, CircuitBreakerOpenException) for link in _chain(error)):
+            # Retrying into an open breaker fails instantly and keeps it open.
+            return max(jittered, self.breaker_wait)
+        return jittered
+
+
+class Retrier:
+    def __init__(
+        self,
+        policy: RetryPolicy,
+        on_incident: OnIncident | None = None,
+        sleep: Sleep = asyncio.sleep,
+    ) -> None:
+        self.policy = policy
+        self._on_incident = on_incident
+        self._sleep = sleep
+
+    async def run[T](
+        self,
+        label: str,
+        attempt: Callable[[], Awaitable[T]],
+        retryable: Callable[[BaseException], bool] = is_provider_failure,
+    ) -> T:
+        """Run `attempt` until it succeeds; each call must start from scratch.
+
+        Only failures `retryable` accepts are retried. Anything else, including an
+        AssertionError from a check, propagates at once: that is the agent's result.
+        """
+        last: BaseException | None = None
+        for number in range(1, self.policy.attempts + 1):
+            try:
+                async with asyncio.timeout(self.policy.timeout):
+                    return await attempt()
+            except Exception as error:
+                if not retryable(error):
+                    raise
+                last = error
+                if self._on_incident is not None:
+                    self._on_incident(label, number, error)
+                if number < self.policy.attempts:
+                    await self._sleep(self.policy.wait(number, error))
+        raise ProviderUnavailable(label, self.policy.attempts, last)
+
+
+class ProviderDown(ProviderUnavailable):
+    """Not attempted: the provider was already declared down earlier in the run."""
+
+    def __init__(self, reason: str) -> None:
+        Exception.__init__(self, f"not attempted, provider down since: {reason}")
+        self.label, self.attempts, self.cause = "provider down", 0, None
+
+
+class ProviderHealth:
+    """A circuit breaker for the whole evaluation run.
+
+    Once several runs in a row have exhausted their retries the provider is taken to be
+    down, and the remaining tests are skipped at once instead of each waiting out its own
+    retries.
+    """
+
+    def __init__(self, abort_after: int) -> None:
+        self._abort_after = abort_after
+        self._exhausted_in_a_row = 0
+        self.down: str | None = None
+        self.checked = False
+
+    def ensure_up(self) -> None:
+        if self.down is not None:
+            raise ProviderDown(self.down)
+
+    def succeeded(self) -> None:
+        self._exhausted_in_a_row = 0
+
+    def exhausted(self, error: ProviderUnavailable) -> None:
+        if isinstance(error, ProviderDown):
+            return
+        self._exhausted_in_a_row += 1
+        if self._exhausted_in_a_row >= self._abort_after and self.down is None:
+            self.down = str(error)
+
+    def mark_down(self, reason: str) -> None:
+        self.down = reason
