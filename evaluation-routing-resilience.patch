diff --git a/tests/evaluation/harness/settings.py b/tests/evaluation/harness/settings.py
new file mode 100644
index 0000000..c4ba676
--- /dev/null
+++ b/tests/evaluation/harness/settings.py
@@ -0,0 +1,60 @@
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+
+
+def _number[T: (int, float)](
+    name: str, default: T, cast: type[T], low: T, high: T | None = None
+) -> T:
+    raw = os.getenv(name, str(default))
+    try:
+        value = cast(raw)
+    except ValueError:
+        raise ValueError(f"{name}={raw!r} is not a number") from None
+    if value < low or (high is not None and value > high):
+        bounds = f"between {low} and {high}" if high is not None else f"at least {low}"
+        raise ValueError(f"{name}={raw!r} must be {bounds}")
+    return value
+
+
+@dataclass(frozen=True, slots=True)
+class EvalSettings:
+    """How hard the evaluation tries, and how much missing data it tolerates.
+
+    repeats        EVAL_REPEATS         runs of every routing case; an LLM agent is not
+                                        deterministic, so one run says little
+    attempts       EVAL_ATTEMPTS        tries per run when the provider fails, before the
+                                        run is left unscored
+    retry_delay    EVAL_RETRY_DELAY     seconds before the first retry, doubled each time
+    max_delay      EVAL_MAX_RETRY_DELAY ceiling on that wait
+    breaker_wait   EVAL_BREAKER_WAIT    minimum wait once the LLM circuit breaker is open
+    timeout        EVAL_ATTEMPT_TIMEOUT seconds one attempt may take before it is abandoned
+    abort_after    EVAL_ABORT_AFTER     runs in a row that exhaust their retries before the
+                                        provider is declared down and the rest is skipped
+    max_unscored   EVAL_MAX_UNSCORED    share of tests that may go unscored before the whole
+                                        evaluation is called inconclusive
+    """
+
+    repeats: int = 3
+    attempts: int = 3
+    retry_delay: float = 5.0
+    max_delay: float = 60.0
+    breaker_wait: float = 30.0
+    timeout: float = 600.0
+    abort_after: int = 2
+    max_unscored: float = 0.2
+
+    @classmethod
+    def from_env(cls) -> EvalSettings:
+        default = cls()
+        return cls(
+            repeats=_number("EVAL_REPEATS", default.repeats, int, 1),
+            attempts=_number("EVAL_ATTEMPTS", default.attempts, int, 1),
+            retry_delay=_number("EVAL_RETRY_DELAY", default.retry_delay, float, 0.0),
+            max_delay=_number("EVAL_MAX_RETRY_DELAY", default.max_delay, float, 0.0),
+            breaker_wait=_number("EVAL_BREAKER_WAIT", default.breaker_wait, float, 0.0),
+            timeout=_number("EVAL_ATTEMPT_TIMEOUT", default.timeout, float, 1.0),
+            abort_after=_number("EVAL_ABORT_AFTER", default.abort_after, int, 1),
+            max_unscored=_number("EVAL_MAX_UNSCORED", default.max_unscored, float, 0.0, 1.0),
+        )
