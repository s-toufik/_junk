+++ b/tests/evaluation/harness/runner.py
@@ -0,0 +1,119 @@
+from __future__ import annotations
+
+from collections.abc import Callable
+from dataclasses import dataclass
+
+from tests.evaluation.harness.cases import Case, Say
+from tests.evaluation.harness.contract import contract_checks
+from tests.evaluation.harness.exchange import Exchange
+from tests.evaluation.harness.resilience import (
+    ProviderHealth,
+    ProviderUnavailable,
+    Retrier,
+    raise_if_toolbox_unreachable,
+)
+from tests.evaluation.harness.route_coverage import RouteCoverage
+from tests.evaluation.harness.routing import RoutingStats
+from tests.evaluation.harness.score import Check, Score
+from tests.evaluation.harness.session import EvalSession
+
+
+@dataclass(frozen=True, slots=True)
+class Observation:
+    say: Say
+    exchange: Exchange
+    expected: tuple[Check, ...]
+    contract: tuple[Check, ...]
+
+
+@dataclass(frozen=True, slots=True)
+class CaseRun:
+    observations: tuple[Observation, ...]
+
+    @property
+    def checks(self) -> list[Check]:
+        found: list[Check] = []
+        for number, seen in enumerate(self.observations, 1):
+            where = f"message {number} {seen.say.message!r}"
+            found += [
+                Check(check.name, check.passed, f"{where}: {check.detail}")
+                for check in (*seen.expected, *seen.contract)
+            ]
+        return found
+
+
+async def play(case: Case, session: EvalSession) -> CaseRun:
+    """Play every message of a case once, in one conversation."""
+    observations: list[Observation] = []
+    for say in case.says:
+        exchange = await session.say(say.message, auto_approve=say.auto_approve)
+        raise_if_toolbox_unreachable(exchange.turn)
+        observations.append(
+            Observation(
+                say,
+                exchange,
+                tuple(say.expect.checks(exchange)),
+                tuple(contract_checks(exchange)),
+            )
+        )
+    return CaseRun(tuple(observations))
+
+
+class CaseEvaluator:
+    """Runs a case several times, each run retried from a fresh conversation on outages."""
+
+    def __init__(
+        self,
+        new_session: Callable[[], EvalSession],
+        retrier: Retrier,
+        health: ProviderHealth,
+        repeats: int,
+        threshold: float,
+        coverage: RouteCoverage,
+        routing: RoutingStats,
+    ) -> None:
+        self._new_session = new_session
+        self._retrier = retrier
+        self._health = health
+        self._repeats = repeats
+        self._threshold = threshold
+        self._coverage = coverage
+        self._routing = routing
+
+    async def evaluate(self, case: Case) -> Score:
+        """The score of the runs that completed.
+
+        Raises ProviderUnavailable when no run completed: there is nothing to score.
+        """
+        completed: list[CaseRun] = []
+        unscored = 0
+        last: ProviderUnavailable | None = None
+        self._health.ensure_up()
+        for repeat in range(1, self._repeats + 1):
+            if self._health.down is not None:
+                # Keep what already completed; the runs left would only wait out retries.
+                unscored += self._repeats - repeat + 1
+                break
+            label = f"{case.name} [run {repeat}/{self._repeats}]"
+            try:
+                # A fresh session per attempt: a turn that died half-way may have left
+                # a partial checkpoint behind, and resuming from it would skew the route.
+                run = await self._retrier.run(label, lambda: play(case, self._new_session()))
+            except ProviderUnavailable as error:
+                self._health.exhausted(error)
+                unscored += 1
+                last = error
+                continue
+            self._health.succeeded()
+            completed.append(run)
+            self._record(run)
+        if not completed:
+            raise last or ProviderUnavailable(case.name, 0, None)
+        return Score.of_runs(
+            case.name, [run.checks for run in completed], self._threshold, unscored
+        )
+
+    def _record(self, run: CaseRun) -> None:
+        for seen in run.observations:
+            self._coverage.record(seen.exchange.route)
+            self._routing.record(seen.say.expect, seen.exchange, seen.contract)
