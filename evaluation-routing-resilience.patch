+++ b/tests/evaluation/harness/routing.py
@@ -0,0 +1,123 @@
+"""Routing metrics pooled over every turn of every scored run.
+
+A case score says whether a scenario went right. These say *where* routing goes wrong:
+which intents get confused for which, at which step a route leaves the expected path,
+and which workflow rules get broken.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+from typing import Any
+
+from agent_orchestrator.domain.workflow.step import Step
+from tests.evaluation.harness.exchange import Exchange
+from tests.evaluation.harness.expectation import Expect
+from tests.evaluation.harness.score import Check
+
+
+def divergence(expected: Sequence[Step], actual: Sequence[Step]) -> str | None:
+    """Where an actual route first leaves the expected one, or None when they match."""
+    for position, (want, got) in enumerate(zip(expected, actual, strict=False), 1):
+        if want is not got:
+            return f"step {position}: {want} -> {got}"
+    if len(actual) < len(expected):
+        return f"step {len(actual) + 1}: {expected[len(actual)]} -> (stopped)"
+    if len(actual) > len(expected):
+        return f"step {len(expected) + 1}: (end) -> {actual[len(expected)]}"
+    return None
+
+
+@dataclass(slots=True)
+class Tally:
+    right: int = 0
+    total: int = 0
+
+    def add(self, passed: bool) -> None:
+        self.right += passed
+        self.total += 1
+
+    @property
+    def rate(self) -> float | None:
+        return self.right / self.total if self.total else None
+
+    def render(self) -> str:
+        if not self.total:
+            return "not measured"
+        return f"{self.right}/{self.total} ({self.right / self.total:.0%})"
+
+
+@dataclass(slots=True)
+class RoutingStats:
+    turns: int = 0
+    intent: Tally = field(default_factory=Tally)
+    route: Tally = field(default_factory=Tally)
+    outcome: Tally = field(default_factory=Tally)
+    tools: Tally = field(default_factory=Tally)
+    confusions: Counter[str] = field(default_factory=Counter)
+    divergences: Counter[str] = field(default_factory=Counter)
+    misrouted_outcomes: Counter[str] = field(default_factory=Counter)
+    broken_rules: Counter[str] = field(default_factory=Counter)
+
+    @property
+    def is_empty(self) -> bool:
+        return self.turns == 0
+
+    def record(self, expect: Expect, exchange: Exchange, contract: Sequence[Check]) -> None:
+        self.turns += 1
+        if expect.intents:
+            correct = exchange.intent in expect.intents
+            self.intent.add(correct)
+            if not correct:
+                wanted = "/".join(str(intent) for intent in expect.intents)
+                self.confusions[f"{wanted} -> {exchange.intent}"] += 1
+        if expect.route is not None:
+            where = divergence(expect.route, exchange.route)
+            self.route.add(where is None)
+            if where is not None:
+                self.divergences[where] += 1
+        if expect.outcome is not None:
+            correct = exchange.outcome is expect.outcome
+            self.outcome.add(correct)
+            if not correct:
+                self.misrouted_outcomes[f"{expect.outcome} -> {exchange.outcome}"] += 1
+        if expect.tools is not None:
+            self.tools.add(exchange.tools == expect.tools)
+        self.broken_rules.update(check.name for check in contract if not check.passed)
+
+    def report(self) -> list[str]:
+        if self.is_empty:
+            return ["routing: no turn scored"]
+        lines = [
+            f"routing over {self.turns} turns",
+            f"  intent   {self.intent.render()}",
+            f"  route    {self.route.render()}",
+            f"  outcome  {self.outcome.render()}",
+            f"  tools    {self.tools.render()}",
+        ]
+        for title, counts in (
+            ("intent confused", self.confusions),
+            ("route left the path at", self.divergences),
+            ("outcome confused", self.misrouted_outcomes),
+            ("workflow rule broken", self.broken_rules),
+        ):
+            lines += [f"  {title}: {what} x{count}" for what, count in counts.most_common()]
+        return lines
+
+    def as_dict(self) -> dict[str, Any]:
+        def tally(t: Tally) -> dict[str, Any]:
+            return {"right": t.right, "total": t.total, "rate": t.rate}
+
+        return {
+            "turns": self.turns,
+            "intent_accuracy": tally(self.intent),
+            "route_exact_match": tally(self.route),
+            "outcome_accuracy": tally(self.outcome),
+            "tool_sequence_match": tally(self.tools),
+            "intent_confusions": dict(self.confusions.most_common()),
+            "route_divergences": dict(self.divergences.most_common()),
+            "outcome_confusions": dict(self.misrouted_outcomes.most_common()),
+            "broken_rules": dict(self.broken_rules.most_common()),
+        }
